{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abeouga/drive-logger/blob/main/contracts/app/rides.schema.json",
  "version": 4,
  "title": "rides.json（走行一覧。カード用の要約とスパークライン）",
  "type": "object",
  "required": ["generated_at_ms", "rides"],
  "additionalProperties": false,
  "properties": {
    "generated_at_ms": { "type": "integer", "description": "作った UNIX ミリ秒" },
    "rides": { "type": "array", "items": { "$ref": "#/$defs/rideSummary" }, "description": "走行 ID の順" }
  },
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "rideSummary": {
      "type": "object",
      "required": ["id", "name", "start_ms", "duration_s", "distance_km", "max_speed_kmh", "fix_ratio", "gps", "n_windows", "n_anomalies", "anomaly_method", "n_anomaly_z", "n_anomaly_if", "n_clipped", "rms_median", "spark", "memo"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "走行 ID" },
        "name": { "type": "string", "minLength": 1, "description": "見出しに出す名前（台帳の name。並べ替えには使わない）" },
        "start_ms": { "type": ["integer", "null"], "description": "記録開始の UNIX ミリ秒。GPS なしは null" },
        "duration_s": { "type": "number", "description": "長さ（秒）" },
        "distance_km": { "type": "number", "description": "GPS のある連続する窓の距離の合計" },
        "max_speed_kmh": { "type": ["number", "null"], "description": "GPS なしは null" },
        "fix_ratio": { "type": "number", "minimum": 0, "maximum": 1, "description": "GPS のある窓の割合" },
        "gps": { "enum": ["full", "partial", "none"], "description": "0.95 以上／0.10 以上／未満" },
        "n_windows": { "type": "integer", "minimum": 0 },
        "n_anomalies": { "type": "integer", "minimum": 0, "description": "いつもと違う振動の窓の数（判定しない走行は 0。anomaly_method で見分ける）" },
        "anomaly_method": { "$ref": "ride.schema.json#/$defs/anomalyMethod" },
        "n_anomaly_z": { "type": "integer", "minimum": 0 },
        "n_anomaly_if": { "type": "integer", "minimum": 0 },
        "n_clipped": { "type": "integer", "minimum": 0 },
        "rms_median": { "type": "number" },
        "spark": { "type": "array", "items": { "$ref": "#/$defs/nullableNumber" }, "maxItems": 60, "description": "rms を最大 60 区間に平均したもの" },
        "memo": { "type": "string", "description": "走行メモ（notes.md・memo.txt・readme.txt）" },
        "recording": { "$ref": "#/$defs/recording" }
      }
    },
    "recording": {
      "type": "object",
      "required": ["firmware", "accel_chip", "accel_bus", "accel_odr_hz", "accel_fs_hz", "accel_range_g", "feature_fs_hz"],
      "additionalProperties": false,
      "description": "加速度の記録の設定（meta.json と実測から作る）。走行ごとの設定を画面で見分けるため。任意の項目で、この項目を足す前に処理した走行には無い",
      "properties": {
        "firmware": { "type": ["string", "null"], "description": "firmware の版（meta.json の firmware）" },
        "accel_chip": { "type": ["string", "null"], "description": "センサーの名前（meta.json の accel.chip）" },
        "accel_bus": { "enum": ["i2c", "spi", null], "description": "つなぎ方（meta.json の accel.bus。V3.6 までは書いていないので i2c とみなす）" },
        "accel_odr_hz": { "type": ["number", "null"], "description": "出力の速さの設定（meta.json の accel.odr_hz）" },
        "accel_fs_hz": { "type": "number", "description": "実測の速さ（サンプル数 − 1）÷ 記録の長さ。小数 1 桁" },
        "accel_range_g": { "type": ["number", "null"], "description": "振り切れる大きさ ±g（meta.json の accel.range_g）" },
        "feature_fs_hz": { "type": "number", "description": "振動の特徴量を計算した速さ（800 Hz の走行は 400 Hz に間引く）。小数 1 桁" }
      }
    }
  }
}
