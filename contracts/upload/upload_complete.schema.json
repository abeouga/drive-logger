{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abeouga/drive-logger/blob/main/contracts/upload/upload_complete.schema.json",
  "version": 2,
  "title": "raw/<走行>/upload_complete.json（完了の印。これが置かれると処理が動く）",
  "type": "object",
  "required": ["ride_id", "files", "uploaded_at"],
  "properties": {
    "ride_id": { "type": "string", "pattern": "^ride_([0-9]{8}_[0-9]{6}(_[0-9]{1,2})?|[0-9]{3})$" },
    "files": { "type": "array", "items": { "type": "string" } },
    "uploaded_at": { "type": "string", "format": "date-time" },
    "source": { "enum": ["device"], "description": "デバイス API が置いたとき。PC から直接上げた古い走行には無い" },
    "device_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "local_session": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
    "memo_added_at": { "type": "string", "format": "date-time", "description": "送り終えた後に走行メモを足して、この印を置き直した時刻（#100）。files にそのメモが入る" }
  }
}
