{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abeouga/drive-logger/blob/main/contracts/upload/start_response.schema.json",
  "version": 3,
  "title": "POST /api/device/uploads の応答",
  "type": "object",
  "required": [
    "ride_id",
    "expires_in",
    "uploads",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "ride_id": {
      "type": "string",
      "pattern": "^ride_[0-9]{8}_[0-9]{6}(_[0-9]{1,2})?$",
      "description": "サーバーが付けた走行 ID。機器は SD に残し、完了の報告とやり直しで使う"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 1,
      "description": "URL の有効期間（秒）"
    },
    "uploads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "description": "このファイルを HTTP PUT で送る先（期限付き）"
          }
        }
      },
      "description": "送る先。already_uploaded なら空"
    },
    "status": {
      "enum": [
        "new",
        "resumed",
        "already_uploaded",
        "memo_added"
      ],
      "description": "new＝新しい走行、resumed＝途中から、already_uploaded＝同じ SD の走行（セッション名と必須のファイルの大きさが同じ）を送り終えている。uploads は空で、そのまま完了を報告すればよい（#14）。memo_added＝同じ SD の走行を送り終えているが、走行メモ（notes.md など）が S3 に無いか大きさが違う。uploads はそのメモの分だけで、送ったら完了を報告する（#100）"
    }
  }
}
