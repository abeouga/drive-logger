{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abeouga/drive-logger/blob/main/contracts/upload/upload_session.schema.json",
  "version": 1,
  "title": "raw/<走行>/upload_session.json（受け付けの記録。デバイス API が置く）",
  "type": "object",
  "required": ["ride_id", "device_id", "local_session", "files", "created_at"],
  "additionalProperties": false,
  "properties": {
    "ride_id": { "type": "string", "pattern": "^ride_[0-9]{8}_[0-9]{6}(_[0-9]{1,2})?$" },
    "device_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "local_session": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "size"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "size": { "type": "integer", "minimum": 0 } }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
