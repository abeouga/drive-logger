{
  "name": "ct125-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CT125 走行データの Web アプリ（Vite。dev は S3 から、build は CloudFront 配信用）",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localapi",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.16.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
