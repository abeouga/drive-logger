# dev サーバーの設定の見本（値は伏せてある）。実際の値はコミットしない .local のファイルに置く：
#   npm run dev      → .env.development.local（本番）
#   npm run dev:test → .env.testenv.local（test）
# Terraform が読める PC では scripts/start-dev.ps1（-Env test）が出力から作るので、ふつうは手で書かなくてよい。
# Terraform を使わない PC では、このファイルをコピーして上のファイルを作り、<> の所を Terraform の出力の値にする。
# VITE_ で始まる変数はブラウザに埋め込まれる（ここの値はどれも秘密ではない：ログイン画面の場所とクライアント ID）

# /api/* を中継する先（その環境の画面の URL。Terraform の出力の app_url の末尾の / を除いたもの）
API_ORIGIN=https://<画面のドメイン>

# ログインの設定（Terraform の出力の auth_authority・auth_client_id・auth_domain）
VITE_AUTH_AUTHORITY=https://cognito-idp.<リージョン>.amazonaws.com/<ユーザープール ID>
VITE_AUTH_CLIENT_ID=<アプリクライアント ID>
VITE_AUTH_DOMAIN=https://<prefix>.auth.<リージョン>.amazoncognito.com

# npm run dev:local が /api/* を中継する先（手元で動かしたデータ API）。既定の http://localhost:8000 から変えるときだけ、.env.local に書く
# LOCAL_API_ORIGIN=http://localhost:8000
