# dev で使う設定の見本。ふつうは scripts/start-dev.ps1 が Terraform の出力から .env.development.local を作るので、手で書かなくてよい。
# VITE_ で始まる変数はブラウザに埋め込まれる（ここの値はどれも秘密ではない：ログイン画面の場所とクライアント ID）

# npm run dev が /api/* を中継する先（公開ドメイン）
API_ORIGIN=https://drive.herdio-system.com
# npm run dev:local が /api/* を中継する先（手元で動かしたデータ API）
LOCAL_API_ORIGIN=http://localhost:8000

VITE_AUTH_AUTHORITY=https://cognito-idp.ap-northeast-1.amazonaws.com/<ユーザープール ID>
VITE_AUTH_CLIENT_ID=<アプリクライアント ID>
VITE_AUTH_DOMAIN=https://<prefix>.auth.ap-northeast-1.amazoncognito.com
