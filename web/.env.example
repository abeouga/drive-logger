# .env.local にコピーして値を入れる（.env.local はコミットしない）
# VITE_ で始まる変数はブラウザに埋め込まれるので、AWS 関係には付けない

# s3：dev サーバーがローカルの AWS プロファイルで S3 から取る（cache/ にも保存）
# cache：cache/ だけを使う（オフライン）
DATA_SOURCE=s3

AWS_PROFILE=ct125-logger
AWS_REGION=ap-northeast-1
S3_BUCKET=ct125-logger-public-<アカウントID>
S3_PREFIX=datasets/shared/
